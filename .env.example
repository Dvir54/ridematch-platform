# RideMatch — copy to .env and fill in. Never commit .env.

# ── App ──
APP_ENV=development                 # development | test | production (production refuses to start on an unsafe config)
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ── PostgreSQL ──
POSTGRES_USER=ridematch
POSTGRES_PASSWORD=ridematch
POSTGRES_DB=ridematch
# Host port 5434 (docker-compose maps 5434 → container 5432; a native PostgreSQL holds 5432 locally)
DATABASE_URL=postgresql+asyncpg://ridematch:ridematch@localhost:5434/ridematch
# Tests use a separate DB so they never touch dev data
TEST_DATABASE_URL=postgresql+asyncpg://ridematch:ridematch@localhost:5434/ridematch_test
# postgres:// and postgresql:// are rewritten to postgresql+asyncpg://
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10                  # keep pool+overflow under the managed DB's connection cap
DB_COMMAND_TIMEOUT_SECONDS=30

# ── Redis ──
REDIS_URL=redis://localhost:6379/0     # WebSocket registry

# ── Auth (Clerk) ──  values from Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_xxx                         # backend only; used for ban/unban via Backend API
CLERK_ISSUER=https://your-app.clerk.accounts.dev     # the Frontend API URL; must equal the token's `iss`
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_KEY=                                       # optional PEM public key → verify without network. Tests set their own.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173       # comma-separated allowed `azp` (frontend origins)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx               # Dashboard → Webhooks → endpoint signing secret

# ── WebSocket ──
WS_AUTH_TIMEOUT_SECONDS=10          # the first message must be {"event":"auth"} within this

# ── Matching ──
SEARCH_RADIUS_KM=10
MATCH_MIN_SCORE=40

# ── Email ──
EMAIL_BACKEND=console               # console | smtp | memory (tests: in-memory outbox)
EMAIL_FROM=noreply@ridematch.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Background jobs ──
JOBS_ENABLED=true                   # false in tests; tests trigger jobs directly
REMINDER_MINUTES_BEFORE=60
AUTO_COMPLETE_AFTER_HOURS=12

# ── Error monitoring (Sentry, errors only; empty = off) ──
SENTRY_DSN=

# ── Admin ──
ADMIN_EMAIL=you@example.com         # dev/test only: onboarding with this email creates the first admin.
                                    # Must be empty in production; use `python -m app.admin_cli grant <email>`

# ── Frontend (Vite exposes only VITE_* to the browser; vite.config uses envDir: '..') ──
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx              # safe to expose
VITE_MAPBOX_TOKEN=pk.xxx                             # public token; restrict to your domains in Mapbox
VITE_SENTRY_DSN=                                     # frontend Sentry DSN; empty = off

# ══ Production (Render; see render.yaml and backend/README.md "Deploy on Render") ══
# Not read from a file in production: the API gets these from the Render service's environment,
# the frontend gets the VITE_* ones as Static Site build variables. <domain> = your domain.
# APP_ENV=production refuses to start until every rule in app/config.py production_problems holds.
#
# API (ridematch-api)
# APP_ENV=production
# CORS_ORIGINS=https://app.<domain>                    # https only, no localhost, no '*'
# CLERK_AUTHORIZED_PARTIES=https://app.<domain>        # must include every CORS origin
# CLERK_ISSUER=https://clerk.<domain>                  # production instance, not *.clerk.accounts.dev
# CLERK_JWKS_URL=https://clerk.<domain>/.well-known/jwks.json
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...          # required: Clerk → API Keys → JWKS Public Key (PEM)
# CLERK_SECRET_KEY=sk_live_xxx                         # a live key
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx               # endpoint https://api.<domain>/api/v1/webhooks/clerk
# DATABASE_URL=                                        # from Render Postgres (internal URL); postgres:// is rewritten
# REDIS_URL=                                           # from Render Key Value (internal URL)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# EMAIL_BACKEND=smtp
# EMAIL_FROM=noreply@<domain>                          # a real, verified sender (not *.local)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587                                        # 587 STARTTLS or 465 implicit TLS
# SMTP_USER=
# SMTP_PASSWORD=
# JOBS_ENABLED=true
# SENTRY_DSN=                                          # backend project; empty = off
# ADMIN_EMAIL=                                         # must stay empty in production
#
# Frontend (ridematch-web build variables; public, baked into the bundle)
# VITE_API_BASE_URL=https://api.<domain>/api/v1
# VITE_WS_URL=wss://api.<domain>/api/v1/ws
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx
# VITE_MAPBOX_TOKEN=pk.xxx                             # restricted to https://app.<domain> in Mapbox
# VITE_SENTRY_DSN=                                     # frontend project; empty = off
